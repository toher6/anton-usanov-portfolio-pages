---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { zoomSource } from '../scripts/zoom-source';
import detailSignup from '../assets/images/playground/detail-signup.png';
import dexsportAcademy from '../assets/images/playground/dexsport-academy.png';
import evaVpn from '../assets/images/playground/eva-vpn.png';

/*
  Витрина «Playground» — три работы в столбик (Figma node 359-1387).
  Кадр держит соотношение сторон из макета, картинка вписывается object-fit:
  cover. Исходники подрезаны ровно под кадр (dexsport-academy обрезан по кропу
  из Figma — без верхнего заголовка), поэтому cover не съедает ничего лишнего,
  а в лайтбоксе открывается та же композиция, что видна в сетке.
*/
interface Figure {
  src: ImageMetadata;
  w: number;
  h: number;
}

const FIGURES: Figure[] = [
  { src: detailSignup, w: 1200, h: 852 },
  { src: dexsportAcademy, w: 1200, h: 636 },
  { src: evaVpn, w: 1200, h: 672 },
];

// Полноразмерный источник для лайтбокса (клик — на всё окно, как в кейсах)
const zooms = await Promise.all(FIGURES.map((f) => zoomSource(f.src)));
---

<div class="figures">
  {FIGURES.map((f, i) => (
    <div class="figure" style={`aspect-ratio:${f.w} / ${f.h}`}>
      <Image
        src={f.src}
        alt=""
        width={Math.min(3600, f.src.width)}
        format="webp"
        class="figure__image"
        data-zoomable
        {...zooms[i]}
        role="button"
        tabindex="0"
        aria-label="Открыть изображение на всё окно"
      />
    </div>
  ))}
</div>

<style>
  .figures {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 52px;
    width: 100%;
  }

  .figure {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: var(--color-black-3);
  }

  .figure__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: zoom-in;
  }

  /* Ниже 576px блока в Figma нет — картинки просто ужимаются под сетку */
  @media (max-width: 575.98px) {
    .figures {
      gap: 24px;
    }
  }
</style>
