---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { zoomSource } from '../scripts/zoom-source';

interface Props {
  image: ImageMetadata;
  caption?: string;
  framed?: boolean;
  radius?: string;
}

const { image, caption, framed = true, radius } = Astro.props;
const zoomSrc = await zoomSource(image);
---

<figure class="image-block">
  {framed ? (
    <div class="frame">
      <Image src={image} alt="" width={Math.min(3504, image.width)} format="webp" data-zoomable data-zoom-src={zoomSrc} role="button" tabindex="0" aria-label="Открыть изображение на всё окно" class="image" style={radius ? `border-radius:${radius}` : undefined} />
    </div>
  ) : (
    <Image src={image} alt="" width={Math.min(3600, image.width)} format="webp" data-zoomable data-zoom-src={zoomSrc} role="button" tabindex="0" aria-label="Открыть изображение на всё окно" class="image image--flush" style={radius ? `border-radius:${radius}` : undefined} />
  )}
  {caption && <figcaption class="text-tag caption" data-i18n-scope>{caption}</figcaption>}
</figure>

<style>
  .image-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .frame {
    display: flex;
    padding: 16px;
    border-radius: var(--radius-xl);
    background: var(--color-black-3);
    width: 100%;
  }

  .image {
    width: 100%;
    height: auto;
    cursor: zoom-in;
  }

  .frame .image {
    border-radius: var(--radius-sm);
  }

  .image--flush {
    border-radius: var(--radius-lg);
  }

  .caption {
    color: var(--color-blue-dusk);
    text-align: center;
  }

  /* Мобильная (node 307:4953) — рамка почти вплотную к изображению */
  @media (max-width: 575.98px) {
    .frame {
      padding: 4px;
      border-radius: var(--radius-md);
    }

    .image--flush {
      border-radius: var(--radius-md);
    }
  }
</style>
