---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { zoomSource } from '../scripts/zoom-source';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  caption?: string;
}

const { before, after, beforeLabel, afterLabel, caption } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
const [beforeZoom, afterZoom] = await Promise.all([zoomSource(before), zoomSource(after)]);

/*
  Один щедрый размер на все ширины, как в ImageBlock и Gallery: 3× от
  десктопного слота 1200px. На плотном мобильном экране картинка так с
  запасом пересэмплирована и остаётся резкой. Пробовал viewport-srcset ради
  веса — на телефоне браузер выбирал 1200px, и скриншоты с мелким текстом
  «плыли» рядом с пересэмплированными галереями.
*/
const layerWidth = (image: ImageMetadata) => Math.min(3600, image.width);
---

<figure class="slider-block">
  {/* Мобильный режим (node 307:5512): вместо перетаскиваемой шторки —
      переключатель вариантов, тащить её пальцем на 368px неудобно */}
  <div class="switcher" data-before-after-switcher>
    <button type="button" class="switch-item" data-pos="100" aria-pressed="true">
      <span class="text-button" data-i18n-scope>{beforeLabel}</span>
    </button>
    <button type="button" class="switch-item" data-pos="0" aria-pressed="false">
      <span class="text-button" data-i18n-scope>{afterLabel}</span>
    </button>
  </div>
  <div class="slider" data-before-after-slider data-variant="before">
    <Image
      src={after}
      alt=""
      width={layerWidth(after)}
      format="webp"
      class="layer layer--after"
      data-zoomable
      {...afterZoom}
      role="button"
      aria-label="Открыть изображение на всё окно"
    />
    <Image
      src={before}
      alt=""
      width={layerWidth(before)}
      format="webp"
      class="layer layer--before"
      data-zoomable
      {...beforeZoom}
      role="button"
      aria-label="Открыть изображение на всё окно"
    />
    <span class="tag tag--left" data-i18n-scope>{beforeLabel}</span>
    <span class="tag tag--right" data-i18n-scope>{afterLabel}</span>
    <div class="divider-line" aria-hidden="true"></div>
    <div class="handle" aria-hidden="true">
      <Icon name="arrows-horizontal" class="handle-icon" />
    </div>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="range"
      aria-label={`${beforeLabel} / ${afterLabel}`}
      id={`slider-${uid}`}
    />
  </div>
  {caption && <figcaption class="text-tag caption" data-i18n-scope>{caption}</figcaption>}
</figure>

<style>
  .slider-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .slider {
    /* Позиция шторки в CSS, а не в inline-стиле: так её перебивает
       медиазапрос, а JS ставит inline только при взаимодействии */
    --pos: 50%;
    position: relative;
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    user-select: none;
  }

  .switcher {
    display: none;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-md);
    background: var(--color-black-9);
  }

  .switch-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: var(--radius-sm);
    color: var(--color-zinc-dust);
  }

  .switch-item[aria-pressed='true'] {
    background: var(--color-white);
    color: var(--color-black);
  }

  .layer {
    display: block;
    width: 100%;
    height: auto;
  }

  .layer--after {
    position: relative;
  }

  .layer--before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .tag {
    position: absolute;
    top: 32px;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-black-64);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--text-tag-size);
    line-height: var(--text-tag-line);
    font-weight: var(--text-tag-weight);
    pointer-events: none;
  }

  .tag--left {
    left: 32px;
  }

  .tag--right {
    right: 32px;
  }

  .divider-line {
    position: absolute;
    top: 0;
    left: var(--pos);
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: var(--color-black-6);
    pointer-events: none;
  }

  .handle {
    position: absolute;
    top: 50%;
    left: var(--pos);
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-black);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .handle-icon {
    width: 20px;
    height: 20px;
  }

  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
  }

  .caption {
    color: var(--color-blue-dusk);
    text-align: center;
  }

  @media (max-width: 575.98px) {
    .slider-block {
      gap: 12px;
    }

    /* Показан целиком один вариант, выбранный переключателем.
       Радиуса у изображения в мобильном макете нет (node 307:5512) */
    .slider {
      --pos: 100%;
      border-radius: 0;
    }

    /* Обрезка тут не нужна, а clip-path выносит слой в отдельную композицию,
       где браузер масштабирует картинку грубее. Прячем целиком */
    .layer--before {
      clip-path: none;
    }
    .slider[data-variant='after'] .layer--before {
      visibility: hidden;
    }

    .switcher {
      display: flex;
    }

    .tag,
    .divider-line,
    .handle,
    .range {
      display: none;
    }
  }
</style>

<script>
  function initSliders(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-before-after-slider]').forEach((slider) => {
      if (slider.dataset.wired) return;
      slider.dataset.wired = 'true';
      const range = slider.querySelector<HTMLInputElement>('.range');
      range?.addEventListener('input', () => {
        slider.style.setProperty('--pos', `${range.value}%`);
      });

      /*
        На десктопе поверх картинок лежит прозрачный range для перетаскивания,
        и клик до них не доходит. Ловим его здесь и переадресуем той половине,
        по которой попали, — дальше открытие подхватывает Lightbox.
        На мобильной range скрыт, клик попадает в картинку сам.
      */
      let downX = 0;
      let downY = 0;
      slider.addEventListener('pointerdown', (event) => {
        downX = event.clientX;
        downY = event.clientY;
      });
      slider.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (!target.classList.contains('range')) return;
        // Перетаскивание шторки — не клик
        if (Math.hypot(event.clientX - downX, event.clientY - downY) > 5) return;

        const rect = slider.getBoundingClientRect();
        const pos = parseFloat(getComputedStyle(slider).getPropertyValue('--pos')) || 50;
        const atPercent = ((event.clientX - rect.left) / rect.width) * 100;
        slider.querySelector<HTMLElement>(atPercent < pos ? '.layer--before' : '.layer--after')?.click();
      });

      // Мобильный переключатель гоняет ту же шторку в крайние положения
      const switcher = slider.parentElement?.querySelector<HTMLElement>('[data-before-after-switcher]');
      switcher?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.switch-item');
        if (!button) return;
        switcher.querySelectorAll<HTMLButtonElement>('.switch-item').forEach((item) => {
          item.setAttribute('aria-pressed', String(item === button));
        });
        slider.style.setProperty('--pos', `${button.dataset.pos}%`);
        slider.dataset.variant = button.dataset.pos === '0' ? 'after' : 'before';
      });
    });
  }
  initSliders();
  document.addEventListener('astro:page-load', () => initSliders());
</script>
