---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
  caption?: string;
}

const { before, after, beforeLabel, afterLabel, caption } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---

<figure class="slider-block">
  {/* Мобильный режим (node 307:5512): вместо перетаскиваемой шторки —
      переключатель вариантов, тащить её пальцем на 368px неудобно */}
  <div class="switcher" data-before-after-switcher>
    <button type="button" class="switch-item" data-pos="100" aria-pressed="true">
      <span class="text-button" data-i18n-scope>{beforeLabel}</span>
    </button>
    <button type="button" class="switch-item" data-pos="0" aria-pressed="false">
      <span class="text-button" data-i18n-scope>{afterLabel}</span>
    </button>
  </div>
  <div class="slider" data-before-after-slider>
    <Image src={after} alt="" width={Math.min(2400, after.width)} format="webp" class="layer layer--after" />
    <Image src={before} alt="" width={Math.min(2400, before.width)} format="webp" class="layer layer--before" />
    <span class="tag tag--left" data-i18n-scope>{beforeLabel}</span>
    <span class="tag tag--right" data-i18n-scope>{afterLabel}</span>
    <div class="divider-line" aria-hidden="true"></div>
    <div class="handle" aria-hidden="true">
      <Icon name="arrows-horizontal" class="handle-icon" />
    </div>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="range"
      aria-label={`${beforeLabel} / ${afterLabel}`}
      id={`slider-${uid}`}
    />
  </div>
  {caption && <figcaption class="text-tag caption" data-i18n-scope>{caption}</figcaption>}
</figure>

<style>
  .slider-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
  }

  .slider {
    /* Позиция шторки в CSS, а не в inline-стиле: так её перебивает
       медиазапрос, а JS ставит inline только при взаимодействии */
    --pos: 50%;
    position: relative;
    width: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    user-select: none;
  }

  .switcher {
    display: none;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-md);
    background: var(--color-black-9);
  }

  .switch-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: var(--radius-sm);
    color: var(--color-zinc-dust);
  }

  .switch-item[aria-pressed='true'] {
    background: var(--color-white);
    color: var(--color-black);
  }

  .layer {
    display: block;
    width: 100%;
    height: auto;
  }

  .layer--after {
    position: relative;
  }

  .layer--before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .tag {
    position: absolute;
    top: 32px;
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-black-64);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: var(--text-tag-size);
    line-height: var(--text-tag-line);
    font-weight: var(--text-tag-weight);
    pointer-events: none;
  }

  .tag--left {
    left: 32px;
  }

  .tag--right {
    right: 32px;
  }

  .divider-line {
    position: absolute;
    top: 0;
    left: var(--pos);
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: var(--color-black-6);
    pointer-events: none;
  }

  .handle {
    position: absolute;
    top: 50%;
    left: var(--pos);
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-black);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .handle-icon {
    width: 20px;
    height: 20px;
  }

  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    appearance: none;
  }

  .caption {
    color: var(--color-blue-dusk);
    text-align: center;
  }

  @media (max-width: 575.98px) {
    .slider-block {
      gap: 12px;
    }

    /* Показан целиком один вариант, выбранный переключателем */
    .slider {
      --pos: 100%;
      border-radius: var(--radius-md);
    }

    .switcher {
      display: flex;
    }

    .tag,
    .divider-line,
    .handle,
    .range {
      display: none;
    }
  }
</style>

<script>
  function initSliders(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-before-after-slider]').forEach((slider) => {
      if (slider.dataset.wired) return;
      slider.dataset.wired = 'true';
      const range = slider.querySelector<HTMLInputElement>('.range');
      range?.addEventListener('input', () => {
        slider.style.setProperty('--pos', `${range.value}%`);
      });

      // Мобильный переключатель гоняет ту же шторку в крайние положения
      const switcher = slider.parentElement?.querySelector<HTMLElement>('[data-before-after-switcher]');
      switcher?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.switch-item');
        if (!button) return;
        switcher.querySelectorAll<HTMLButtonElement>('.switch-item').forEach((item) => {
          item.setAttribute('aria-pressed', String(item === button));
        });
        slider.style.setProperty('--pos', `${button.dataset.pos}%`);
      });
    });
  }
  initSliders();
  document.addEventListener('astro:page-load', () => initSliders());
</script>
