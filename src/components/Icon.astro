---
import telegram from '../assets/images/icons/telegram.svg?raw';
import email from '../assets/images/icons/email.svg?raw';
import cv from '../assets/images/icons/cv.svg?raw';
import arrowUpRight from '../assets/images/icons/arrow-up-right.svg?raw';
import arrowLeftCircle from '../assets/images/icons/arrow-left-circle.svg?raw';
import arrowsHorizontal from '../assets/images/icons/arrows-horizontal.svg?raw';
import checkInCircle from '../assets/images/icons/check-in-circle.svg?raw';
import crossInCircle from '../assets/images/icons/cross-in-circle.svg?raw';

const icons = {
  telegram,
  email,
  cv,
  'arrow-up-right': arrowUpRight,
  'arrow-left-circle': arrowLeftCircle,
  'arrows-horizontal': arrowsHorizontal,
  'check-in-circle': checkInCircle,
  'cross-in-circle': crossInCircle,
};

interface Props {
  name: keyof typeof icons;
  class?: string;
  /* Размер задаётся пропом, а не CSS снаружи: scoped-стили родителя не
     доходят до элементов, отрендеренных внутри этого компонента */
  size?: number;
}

const { name, class: className, size = 20 } = Astro.props;
---

<span class:list={['icon', className]} style={`--icon-size:${size}px`} set:html={icons[name]} />

<style>
  .icon {
    display: inline-flex;
    width: var(--icon-size);
    height: var(--icon-size);
    flex-shrink: 0;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
