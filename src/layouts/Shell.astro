---
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Yandex.Metrika counter -->
    <script type="text/javascript" is:inline>
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) {
            return;
          }
        }
        (k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=111070237', 'ym');

      ym(111070237, 'init', {
        ssr: true,
        webvisor: true,
        clickmap: true,
        ecommerce: 'dataLayer',
        referrer: document.referrer,
        url: location.href,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    </script>
    <!-- /Yandex.Metrika counter -->

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Ставим сохранённый язык до первой отрисовки, чтобы избежать мигания RU → EN
      try {
        var lang = localStorage.getItem('lang') || 'ru';
        document.documentElement.dataset.lang = lang;
      } catch (e) {}
      // Скрытое состояние блоков появления — до первой отрисовки, иначе класс,
      // добавленный скриптом позже, даёт видимое «угасание» на загрузке. reveal.ts
      // навешивает наблюдатель. При reduced-motion или без IO класса нет — блоки
      // видны сразу.
      try {
        if (
          'IntersectionObserver' in window &&
          !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)
        ) {
          document.documentElement.classList.add('reveal');
        }
      } catch (e) {}
      // Пока перевод не подставлен, переводимые элементы скрыты стилем.
      // Если скрипт переводов не выполнится, страховка их всё равно покажет
      setTimeout(function () {
        document.documentElement.classList.add('i18n-ready');
      }, 2000);
    </script>
  </head>
  <body>
    <!-- Yandex.Metrika counter, вариант без JS. В <head> его положить нельзя:
         там <noscript> допускает только link, style и meta -->
    <noscript
      ><div><img src="https://mc.yandex.ru/watch/111070237" style="position:absolute; left:-9999px;" alt="" /></div></noscript
    >
    <div class="page-container">
      <slot />
    </div>
    <!-- Оверлеи вне контейнера: у него на планшете overflow-x: clip, который
         обрезает и fixed-потомков -->
    <slot name="overlay" />
    <script src="../scripts/smooth-scroll.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/scramble.ts"></script>
    <script src="../scripts/copy-button.ts"></script>
  </body>
</html>

<style>
  .page-container {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--page-padding-inline);
  }

  /* На планшете и мобильной вёрстке hero-паттерн выходит за пределы контента —
     клипим по ширине вьюпорта, чтобы не появлялся горизонтальный скролл */
  @media (max-width: 1199.98px) {
    .page-container {
      overflow-x: clip;
    }
  }
</style>
